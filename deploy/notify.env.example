# ~/.config/cvc/notify.env for cvc-notify.service (mode 600, never committed).
# Server list / topics / card URL can live in site.yaml (ntfy_servers, ntfy_topics,
# approval_card_url); any variable set here overrides site.yaml.
# Tokens are env-only: CVC_NTFY_TOKEN_<n> matches the n-th server (1-based).
CVC_NTFY_TOKEN_1=<write-only token for the self-hosted server (ntfy token add cvc-publisher)>
CVC_NTFY_TOKEN_2=<write-only token for the reserved ntfy.sh topics (option C fallback)>
# CVC_NTFY_SERVERS=https://ntfy.cvc.example.ts.net,https://ntfy.sh
# CVC_NTFY_TOPICS=alex=cvc-alex-k3j9
# CVC_NOTIFY_QUIET=22:00-07:00
# CVC_NOTIFY_TZ=Europe/London
# REQUIRED: path to the SAME approvals state file the broker writes (default
# /var/lib/cvc/approvals.json). If the broker runs in k3s, this must be its hostPath.
CVC_APPROVALS_STATE=/var/lib/cvc/approvals.json
