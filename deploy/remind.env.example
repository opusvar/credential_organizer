# remind.env.example — template for ~/.config/cvc/remind.env (mode 600).
#
#   install -m 600 deploy/remind.env.example ~/.config/cvc/remind.env
#   ${EDITOR:-nano} ~/.config/cvc/remind.env      # replace every <placeholder>
#
# Read by deploy/cvc-remind.service via EnvironmentFile=. Never commit the real file.
#
# systemd EnvironmentFile syntax, not shell: no `export`, no command substitution,
# no variable expansion ($OTHER is literal). Quote only if the value needs it, and
# do not put a trailing `# comment` on a value line.

# ── Vault auth (personal vault — NOT the agent account) ──────────────────────
BW_SERVER=https://cvc.example.ts.net:8443/vault
BW_CLIENTID=<from Vaultwarden Account Settings → API Key>
BW_CLIENTSECRET=<from Vaultwarden Account Settings → API Key>
BW_PASSWORD=<vault master password>

# ── Home Assistant MQTT ──────────────────────────────────────────────────────
# The HA broker is on the LOCAL network, not behind Tailscale — use its LAN IP.
MQTT_HOST=<LAN IP of Home Assistant MQTT broker>
MQTT_USERNAME=<mqtt username>
MQTT_PASSWORD=<mqtt password>
MQTT_PORT=1883

# ── Policy ───────────────────────────────────────────────────────────────────
ROTATION_MAX_AGE_DAYS=180
HIBP_ENABLED=true
