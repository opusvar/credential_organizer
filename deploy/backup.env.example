# backup.env.example — template for ~/.config/cvc/backup.env (mode 600).
#
#   install -m 600 deploy/backup.env.example ~/.config/cvc/backup.env
#   ${EDITOR:-nano} ~/.config/cvc/backup.env      # replace every <placeholder>
#
# Read by deploy/cvc-backup.service via EnvironmentFile=. Never commit the real file.
#
# systemd EnvironmentFile syntax, not shell: no `export`, no command substitution,
# no variable expansion, no trailing `# comment` on a value line.

# ── Vault auth (personal vault — NOT the agent account) ──────────────────────
BW_SERVER=https://orangepi6.humpback-krait.ts.net:8443/vault
BW_CLIENTID=<from Vaultwarden Account Settings → API Key>
BW_CLIENTSECRET=<from Vaultwarden Account Settings → API Key>
BW_PASSWORD=<vault master password>

# ── Backup destination ──────────────────────────────────────────────────────
# BACKUP_DIR is the LOCAL primary copy; ONEDRIVE_DEST_DIR is the OneDrive staging dir
# (inside the onedrive client's sync_dir). They must be DIFFERENT: copy_to_onedrive()
# copies exports from BACKUP_DIR into ONEDRIVE_DEST_DIR, then runs `onedrive --sync`.
# cvc-backup.service also sets BACKUP_DIR via Environment= — keep them identical.
BACKUP_DIR=/mnt/data/cvc-backups
BACKUP_RETENTION_DAYS=30
ONEDRIVE_DEST_DIR=/mnt/data/onedrive/dan_ai_tool_dock/cvc-backups

# ── Export encryption (REQUIRED) ─────────────────────────────────────────────
# Passphrase for the password-protected export. The backup fails if unset. Restores
# need only the file + this passphrase, so keep a copy OUTSIDE the vault.
BACKUP_EXPORT_PASSWORD=<long-random-passphrase>

# ── OneDrive client (abraunegg, installed on the host) ───────────────────────
ONEDRIVE_BIN=/usr/local/bin/onedrive
ONEDRIVE_CONFIG_DIR=/home/admin/.config/onedrive
