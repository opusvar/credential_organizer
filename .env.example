# Copy to .env and fill in. NEVER commit .env (see .gitignore).

# ── Vaultwarden / Bitwarden CLI ───────────────────────────────────────────────
# Base URL of the self-hosted Vaultwarden (through Caddy on the OPi, Tailscale-only).
BW_SERVER=https://orangepi6.humpback-krait.ts.net:8443/vault
# `bw` unlock session key is injected at runtime, never stored here. Left blank on purpose.
BW_SESSION=

# ── Reminders / Home Assistant (Phase 2) ──────────────────────────────────────
MQTT_HOST=orangepi6.humpback-krait.ts.net
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_DISCOVERY_PREFIX=homeassistant
# Rotation age (days) after which a credential is flagged stale.
ROTATION_MAX_AGE_DAYS=180
# Enable Have-I-Been-Pwned k-anonymity breach checks (true/false).
HIBP_ENABLED=false

# ── Backup / recovery (Phase 3) ───────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
# REQUIRED. Passphrase for `bw export --format encrypted_json --password` (F10). Restores
# need only the file + this passphrase (not the Vaultwarden account), so store it OUTSIDE
# the vault (e.g. printed / in a separate password manager). The backup fails if unset.
BACKUP_EXPORT_PASSWORD=<long-random-passphrase>
# Off-host copy (D9). Staging dir must live inside the onedrive client's sync_dir; the
# exports are copied there from BACKUP_DIR (use a DIFFERENT local dir, e.g.
# /mnt/data/cvc-backups) and a one-shot sync of that single folder is triggered. A failed
# copy or sync makes cvc-backup exit non-zero (the local export is still kept).
ONEDRIVE_DEST_DIR=/mnt/data/onedrive/dan_ai_tool_dock/cvc-backups
ONEDRIVE_BIN=/usr/local/bin/onedrive
# abraunegg client config dir — holds the refresh token. Passed as `--confdir`.
ONEDRIVE_CONFIG_DIR=/home/admin/.config/onedrive

# ── Playwright broker (Phase 4) ───────────────────────────────────────────────
# Bind address for the broker API (keep off public interfaces).
BROKER_BIND=127.0.0.1
BROKER_PORT=8710
# Path to the integrity-chained security audit log (gitignored).
AUDIT_LOG=./audit/access.jsonl
# Path to the operational log — request counts, latency, ACL reloads (not integrity-chained).
OPS_LOG=./audit/ops.jsonl
# Path to the ACL file (which agent may fetch which credential; default-deny).
BROKER_ACL=./deploy/broker-acl.yaml
