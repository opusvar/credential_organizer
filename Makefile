.PHONY: setup test cov lint typecheck fmt broker openapi
# Scaffold conveniences. No target here touches real credentials.

setup:
	python -m pip install -e '.[dev]'

test:
	pytest -q

cov:
	pytest --cov=cvc --cov-report=term-missing

lint:
	ruff check src tests

fmt:
	ruff format src tests

typecheck:
	mypy src

# Run the Phase-4 broker locally (default-deny; reads BROKER_* from .env). Scaffold only.
broker:
	uvicorn cvc.broker.app:app --host $${BROKER_BIND:-127.0.0.1} --port $${BROKER_PORT:-8710}

# Export the live OpenAPI spec to docs/openapi.yaml (regenerate after endpoint changes).
openapi:
	python -c "import yaml; from cvc.broker.app import app; open('docs/openapi.yaml','w').write('# Generated by \`make openapi\` from cvc.broker.app:app.openapi().\n' + yaml.safe_dump(app.openapi(), sort_keys=False))"
